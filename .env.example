# TempoRAG-KG API keys and settings
# Copy this file to .env and fill in actual values.
# NEVER commit .env to git.

# --- LLM API keys ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional: only needed for the GPT-4o ceiling run (~$6)
OPENAI_API_KEY=

# --- Runtime settings ---
CACHE_DIR=./cache
LOG_LEVEL=INFO

# --- Reproducibility ---
RANDOM_SEED=42
